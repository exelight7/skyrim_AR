<Window x:Class="SkyrimArabicInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعريب سكايرم — EXELIGHT" Width="1180" Height="700"
        WindowStyle="None" AllowsTransparency="False" Background="#04060B"
        ResizeMode="CanMinimize" WindowStartupLocation="Manual"
        FontFamily="{StaticResource Cairo}" FontSize="14" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <!-- Structure is laid out left-to-right in screen terms; every text-bearing
         panel sets FlowDirection=RightToLeft itself. -->
    <Window.Resources>
        <PathGeometry x:Key="ShellGeo" Figures="M30,0 L1150,0 L1180,30 L1180,670 L1150,700 L30,700 L0,670 L0,30 Z"/>
        <PathGeometry x:Key="InnerGeo" Figures="M34,8 L1146,8 L1172,34 L1172,666 L1146,692 L34,692 L8,666 L8,34 Z"/>
        <!-- one corner knot (top-left); the other three are mirrored copies -->
        <PathGeometry x:Key="Knot" Figures="M8,78 L8,34 L34,8 L78,8 M15,64 L15,37 L37,15 L64,15 M15,50 L50,15 M8,78 L15,71 M78,8 L71,15 M22.5,26 L26,22.5 L29.5,26 L26,29.5 Z"/>
    </Window.Resources>

    <!-- The window is opaque and cut to shape by a window region; its shadow is a separate
         window (see Chrome.cs). Nothing here needs a clip or a per-frame transparency copy. -->
    <Grid x:Name="Root">
        <Grid x:Name="Shell" Background="#04060B"
              MouseLeftButtonDown="Shell_Drag" MouseMove="Shell_MouseMove">

            <!-- Living backdrop and centrepiece, both built in code -->
            <Canvas x:Name="SceneHost" Width="1180" Height="700" IsHitTestVisible="False"/>

            <!-- Shade that keeps the reading column legible -->
            <Rectangle x:Name="ReadShade" Width="700" HorizontalAlignment="Right" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0004060B" Offset="0"/>
                        <GradientStop Color="#A804060B" Offset="0.55"/>
                        <GradientStop Color="#CC04060B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Canvas x:Name="SigilHost" Width="1180" Height="700" IsHitTestVisible="False"/>

            <!-- ===== Top chrome ===== -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,22,0,0">
                <Button x:Name="BtnClose" Style="{StaticResource WinButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="إغلاق"/>
                <Button Style="{StaticResource WinButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="تصغير"/>
            </StackPanel>
            <StackPanel x:Name="Brand" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,29,78,0" IsHitTestVisible="False">
                <TextBlock Text="مثبّت تعريب سكايرم" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                <Rectangle Width="1" Height="12" Fill="#40FFFFFF" Margin="12,0"/>
                <TextBlock Text="E X E L I G H T" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource GoldLight}" VerticalAlignment="Center"/>
                <Rectangle Width="7" Height="7" Fill="{StaticResource GoldMetalHot}" Margin="12,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </StackPanel>

            <!-- ===== Reading column: welcome / path / options ===== -->
            <Grid x:Name="PageHost" Width="506" HorizontalAlignment="Right" Margin="0,84,78,112" FlowDirection="RightToLeft">

                <!-- 0 · The call -->
                <StackPanel x:Name="PageWelcome" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="34" Height="1.5" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="التعريب العربي الكامل" Style="{StaticResource Eyebrow}"/>
                    </StackPanel>
                    <Grid Margin="0,-34,0,-58">
                        <!-- the title's glow lives in its own cached layer, so the shimmer above it never re-blurs anything -->
                        <Border x:Name="HeroGlowHost" Margin="-50" Padding="50" Background="Transparent" IsHitTestVisible="False">
                            <TextBlock Text="سكايرم" FontFamily="{StaticResource Amiri}" FontWeight="Bold" FontSize="118" Foreground="#E2B96A" Opacity="0.55">
                                <TextBlock.Effect>
                                    <BlurEffect Radius="30"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="HeroTitle" Text="سكايرم" FontFamily="{StaticResource Amiri}" FontWeight="Bold" FontSize="118">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="HeroShimmer" X="-1"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#DDB465" Offset="0"/>
                                    <GradientStop Color="#EBCB8B" Offset="0.36"/>
                                    <GradientStop Color="#FFFDF2" Offset="0.5"/>
                                    <GradientStop Color="#EBCB8B" Offset="0.64"/>
                                    <GradientStop Color="#DDB465" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="بلُغةِ الضّاد" FontFamily="{StaticResource Amiri}" FontSize="35" Foreground="{StaticResource Text}" Margin="2,0,0,-12"/>
                    <!-- ornament: line, diamond, line -->
                    <Grid Height="14" Margin="2,2,0,2" HorizontalAlignment="Left" Width="210" FlowDirection="LeftToRight">
                        <Rectangle Height="1" VerticalAlignment="Center" Margin="0,0,118,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00E2B96A" Offset="0"/>
                                    <GradientStop Color="#B0E2B96A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Height="1" VerticalAlignment="Center" Margin="118,0,0,0" Fill="#B0E2B96A"/>
                        <Rectangle Width="7" Height="7" Fill="{StaticResource GoldMetalHot}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="15" Height="15" Stroke="#80E2B96A" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock Style="{StaticResource Lead}" Margin="0,6,0,0"
                               Text="أراضي الشمال تناديك بلسانك. حواراتها ومهامها وكتبها وقوائمها بعربية فصيحة وخطّ واضح، في خطوات قليلة ودون أن يُمَسّ ملفّ واحد من ملفات اللعبة الأصلية."/>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="Stat1" Text="0" FontWeight="Black" FontSize="27" Foreground="{StaticResource GoldMetalHot}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            <TextBlock Text="نصّ معرَّب" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-6,0,0"/>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Hair}" Margin="18,6"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="Stat2" Text="0" FontWeight="Black" FontSize="27" Foreground="{StaticResource GoldMetalHot}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            <TextBlock Text="ملحقاً مدعوماً" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-6,0,0"/>
                        </StackPanel>
                        <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Hair}" Margin="18,6"/>
                        <StackPanel Grid.Column="4">
                            <TextBlock x:Name="Stat3" Text="0" FontWeight="Black" FontSize="27" Foreground="{StaticResource GoldMetalHot}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            <TextBlock Text="تعديل على الملفات الأصلية" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 1 · The road -->
                <StackPanel x:Name="PagePath" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="34" Height="1.5" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="الفصل الثاني · الطريق" Style="{StaticResource Eyebrow}"/>
                    </StackPanel>
                    <TextBlock Text="أين تقع سكايرم؟" Style="{StaticResource Display}" Margin="0,-6,0,-10"/>
                    <TextBlock Style="{StaticResource Lead}" Text="دُلَّنا على مجلد Skyrim Special Edition الذي يضمّ الملف SkyrimSE.exe، ونتكفّل نحن بالباقي."/>

                    <Grid Margin="0,22,0,0" Height="60">
                        <Border Background="#99060A12" BorderThickness="1">
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="PathBorderBrush" Color="#30FFFFFF"/>
                            </Border.BorderBrush>
                        </Border>
                        <Rectangle x:Name="PathGlow" Height="2" VerticalAlignment="Bottom" Opacity="0.9">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop x:Name="PathGlowStop" Color="#8693A8" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid Margin="8,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M0.5,2.5 L0.5,15.5 L19.5,15.5 L19.5,5.5 L9.5,5.5 L7.5,2.5 Z M0.5,8.5 L19.5,8.5" Stroke="{StaticResource Gold}" StrokeThickness="1.3" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="10,0,12,0" FlowDirection="LeftToRight"/>
                            <TextBox x:Name="PathText" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                     CaretBrush="{StaticResource Gold}" SelectionBrush="{StaticResource Gold}" FontFamily="Segoe UI" FontSize="13.5"
                                     FlowDirection="LeftToRight" VerticalAlignment="Center" TextChanged="PathText_TextChanged"/>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="استعراض" Height="38" Padding="12,0" Margin="10,0,0,0" Click="Browse_Click"/>
                        </Grid>
                    </Grid>

                    <Grid Margin="4,14,0,0" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" Margin="0,3,10,0" VerticalAlignment="Top">
                            <Ellipse x:Name="StatusRing" Stroke="#8693A8" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="StatusDotBrush" Color="#8693A8"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="لم يُحدَّد مجلد بعد" FontSize="13.5" LineHeight="23" TextWrapping="Wrap" Foreground="{StaticResource Soft}" VerticalAlignment="Top"/>
                        <Button x:Name="BtnUninstall" Grid.Column="2" Style="{StaticResource GhostButton}" Content="إزالة التعريب" Height="36" FontSize="13" Padding="8,0" Margin="12,0,0,0" VerticalAlignment="Top" Visibility="Collapsed" Click="Uninstall_Click"/>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="حجم التعريب" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="SpaceText" Text="—" FontWeight="Bold" FontSize="15.5"/>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Hair}" Margin="18,4"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="مبنيّ للإصدار" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="SupportedText" Text="—" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15.5" Margin="0,3,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Hair}" Margin="18,4"/>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="إصدار لعبتك" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="YourVersionText" Text="—" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15.5" Margin="0,3,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 2 · The gear -->
                <StackPanel x:Name="PageOptions" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="34" Height="1.5" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="الفصل الثالث · العتاد" Style="{StaticResource Eyebrow}"/>
                    </StackPanel>
                    <TextBlock Text="جهِّز عتادك" Style="{StaticResource Display}" Margin="0,-6,0,-12"/>

                    <!-- what will be carved: figures read from the embedded payload -->
                    <Grid Margin="0,8,0,6">
                        <Border BorderBrush="#40E2B96A" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22E2B96A" Offset="0"/>
                                    <GradientStop Color="#06E2B96A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Rectangle Width="9" Height="9" Fill="{StaticResource GoldMetalHot}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,18,0" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <StackPanel Margin="20,12,20,14">
                            <TextBlock Text="ما الذي سيُنقش" Style="{StaticResource Eyebrow}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SumStrings" Text="0" FontWeight="Black" FontSize="23" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    <TextBlock Text="نصّاً عربياً" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="SumFiles" Text="0" FontWeight="Black" FontSize="23" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    <TextBlock Text="ملفّ نصوص" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="SumUi" Text="0" FontWeight="Black" FontSize="23" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    <TextBlock Text="ملفّ واجهة وخطّ عربي" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <ToggleButton x:Name="OptBackup" Style="{StaticResource RuneSwitch}" IsChecked="True" Click="Option_Click">
                        <StackPanel>
                            <TextBlock Text="نسخة احتياطية" FontWeight="Bold" FontSize="15.5"/>
                            <TextBlock Text="أي ملف موجود في مكان ملفاتنا يُحفَظ ويُعاد عند الإزالة" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-3,0,0"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="OptShortcut" Style="{StaticResource RuneSwitch}" Click="Option_Click">
                        <StackPanel>
                            <TextBlock Text="اختصار على سطح المكتب" FontWeight="Bold" FontSize="15.5"/>
                            <TextBlock Text="تشغيل سكايرم المعرَّبة مباشرة" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-3,0,0"/>
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock Margin="4,12,0,0" FontSize="12.5" LineHeight="22" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                               Text="التعريب يُضاف ملفاتٍ مستقلة بجوار ملفات اللعبة، ويمكن إزالته من هذا المثبّت في أي وقت."/>
                </StackPanel>
            </Grid>

            <!-- ===== Centre stage: carving / done ===== -->
            <Grid x:Name="StageHost" Width="700" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,96" FlowDirection="RightToLeft">

                <!-- 3 · The carving -->
                <StackPanel x:Name="PageInstall" Visibility="Collapsed" MinHeight="142">
                    <TextBlock x:Name="InstallEyebrow" Text="يُنقَش الآن" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TaskText" Text="التحضير" FontFamily="{StaticResource Amiri}" FontWeight="Bold" FontSize="33" HorizontalAlignment="Center" Margin="0,-10,0,-10"/>
                    <TextBlock x:Name="LogText" Text=" " FontSize="13" LineHeight="23" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
                    <StackPanel x:Name="Pips" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <StackPanel x:Name="ErrorNav" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource PrimaryButton}" Content="حاول مجدداً" Height="48" MinWidth="180" Click="Retry_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="العودة" MinWidth="120" Margin="14,0,0,0" Click="ErrorBack_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 4 · The end -->
                <StackPanel x:Name="PageDone" Visibility="Collapsed" Height="278">
                    <TextBlock x:Name="DoneEyebrow" Text="اكتمل النقش" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"/>
                    <Border x:Name="DoneTitleHost" Margin="-40,-44,-40,-58" Padding="40" Background="Transparent" HorizontalAlignment="Center">
                        <TextBlock x:Name="DoneTitle" Text="سكايرم تتكلّم العربية" FontFamily="{StaticResource Amiri}" FontWeight="Bold" FontSize="52" Foreground="{StaticResource GoldMetalHot}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#E2B96A" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>
                    <TextBlock x:Name="DoneLead" Style="{StaticResource Lead}" HorizontalAlignment="Center" TextAlignment="Center" Text="كل شيء في مكانه، والملفات الأصلية لم تُمَسّ. رحلة موفّقة يا دوفاكين."/>
                    <TextBlock x:Name="DoneNote" FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Text=" "/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="BtnLaunch" Style="{StaticResource PrimaryButton}" Content="ادخل سكايرم" Click="Launch_Click"/>
                        <Button x:Name="BtnFinish" Style="{StaticResource GhostButton}" Content="إنهاء" MinWidth="120" Margin="14,0,0,0" Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ===== Footer: the journey, and the way forward ===== -->
            <Canvas x:Name="StepsHost" Width="506" Height="58" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,78,26">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="StepsShift"/>
                </Canvas.RenderTransform>
            </Canvas>
            <StackPanel x:Name="Nav" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="74,0,0,34">
                <Button x:Name="BtnNext" Style="{StaticResource PrimaryButton}" Content="ابدأ الرحلة" Click="Next_Click"/>
                <Button x:Name="BtnBack" Style="{StaticResource GhostButton}" Content="السابق" MinWidth="118" Margin="14,0,0,0" Click="Back_Click"/>
            </StackPanel>

            <!-- ===== Frame ===== -->
            <Canvas x:Name="FrameHost" IsHitTestVisible="False" Width="1180" Height="700">
                <Path Data="{StaticResource InnerGeo}" Stroke="#16FFFFFF" StrokeThickness="1"/>
                <Path Data="{StaticResource ShellGeo}" Stroke="{StaticResource FrameGold}" StrokeThickness="3"/>
                <Path Data="{StaticResource Knot}" Stroke="{StaticResource Gold}" StrokeThickness="1.2" Opacity="0.85"/>
                <Path Data="{StaticResource Knot}" Stroke="{StaticResource Gold}" StrokeThickness="1.2" Opacity="0.85">
                    <Path.RenderTransform>
                        <MatrixTransform Matrix="-1,0,0,1,1180,0"/>
                    </Path.RenderTransform>
                </Path>
                <Path Data="{StaticResource Knot}" Stroke="{StaticResource Gold}" StrokeThickness="1.2" Opacity="0.85">
                    <Path.RenderTransform>
                        <MatrixTransform Matrix="1,0,0,-1,0,700"/>
                    </Path.RenderTransform>
                </Path>
                <Path Data="{StaticResource Knot}" Stroke="{StaticResource Gold}" StrokeThickness="1.2" Opacity="0.85">
                    <Path.RenderTransform>
                        <MatrixTransform Matrix="-1,0,0,-1,1180,700"/>
                    </Path.RenderTransform>
                </Path>
            </Canvas>
            <!-- a slow light that travels the top edge -->
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="EdgeLight" Width="240" Height="2" Canvas.Top="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFF3CF" Offset="0"/>
                            <GradientStop Color="#FFFFF3CF" Offset="0.5"/>
                            <GradientStop Color="#00FFF3CF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="EdgeLightT" X="-240"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <!-- Opening curtain -->
            <Rectangle x:Name="Curtain" Fill="#04060B" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
